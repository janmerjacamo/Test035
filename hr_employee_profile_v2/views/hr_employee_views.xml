<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_rrhh_v2" model="ir.ui.view">
        <field name="name">hr.employee.form.rrhh.v2</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ficha RRHH Guatemala">
                    <group string="Datos Personales">
                        <group>
                            <field name="x_job_position_service"/>
                            <field name="x_home_phone"/>
                            <field name="x_age" readonly="1"/>
                            <field name="x_dpi"/>
                            <field name="x_dpi_extended"/>
                            <field name="x_nit"/>
                            <field name="x_driver_license"/>
                            <field name="x_igss"/>
                        </group>
                        <group>
                            <field name="x_housing_type"/>
                            <field name="x_years_residence"/>
                            <field name="x_municipality"/>
                            <field name="x_department_residence"/>
                            <field name="x_other_income"/>
                            <field name="x_other_income_notes"/>
                            <field name="x_has_vehicle"/>
                            <field name="x_vehicle_type"/>
                            <field name="x_vehicle_brand"/>
                            <field name="x_has_debts"/>
                            <field name="x_debt_amount"/>
                        </group>
                        <group colspan="2">
                            <field name="x_addresses_notes" placeholder="Direcciones, puntos de referencia o información adicional de residencia"/>
                        </group>
                    </group>

                    <group string="Datos Familiares">
                        <group>
                            <field name="x_father_name"/>
                            <field name="x_father_phone"/>
                            <field name="x_mother_name"/>
                            <field name="x_mother_phone"/>
                            <field name="x_children_count"/>
                            <field name="x_siblings_count"/>
                        </group>
                        <group string="Información del Cónyuge">
                            <field name="x_spouse_name"/>
                            <field name="x_spouse_phone"/>
                            <field name="x_spouse_address"/>
                        </group>
                    </group>

                    <group string="Salud">
                        <group>
                            <field name="x_smokes"/>
                            <field name="x_drinks"/>
                            <field name="x_sports"/>
                            <field name="x_weight"/>
                            <field name="x_height"/>
                            <field name="x_blood_type"/>
                        </group>
                        <group>
                            <field name="x_disabilities"/>
                            <field name="x_disease"/>
                            <field name="x_medication"/>
                        </group>
                    </group>

                    <group string="Trabajo">
                        <group>
                            <field name="x_reentry_date"/>
                            <field name="x_job_address"/>
                            <field name="x_direct_manager"/>
                            <field name="x_assigned_department"/>
                        </group>
                        <group>
                            <field name="x_position_change_date"/>
                            <field name="x_new_position_name"/>
                            <field name="x_contract_condition"/>
                            <field name="x_benefits"/>
                        </group>
                    </group>

                    <group string="Experiencia Laboral">
                        <field name="x_labor_experience_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="company_name"/>
                                <field name="position"/>
                                <field name="time_worked"/>
                                <field name="salary"/>
                                <field name="leaving_reason"/>
                                <field name="immediate_boss"/>
                                <field name="company_phone"/>
                                <field name="can_request_reference"/>
                            </list>
                        </field>
                    </group>

                    <group string="Referencias Personales">
                        <field name="x_personal_reference_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="relationship"/>
                            </list>
                        </field>
                    </group>

                    <group string="Estudios">
                        <field name="x_education_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="degree"/>
                                <field name="year"/>
                                <field name="institution"/>
                                <field name="currently_studying"/>
                                <field name="schedule"/>
                            </list>
                        </field>
                    </group>

                    <group string="Otros Estudios Técnicos">
                        <field name="x_technical_study_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="technical_study"/>
                                <field name="degree"/>
                                <field name="year"/>
                                <field name="institution"/>
                            </list>
                        </field>
                    </group>

                    <group string="Documentos a Cargar">
                        <group>
                            <field name="x_vaccine_card_filename" invisible="1"/>
                            <field name="x_vaccine_card" filename="x_vaccine_card_filename"/>
                            <field name="x_lung_card_filename" invisible="1"/>
                            <field name="x_lung_card" filename="x_lung_card_filename"/>
                            <field name="x_fingerprints_filename" invisible="1"/>
                            <field name="x_fingerprints" filename="x_fingerprints_filename"/>
                        </group>
                        <group>
                            <field name="x_document_acknowledgement_filename" invisible="1"/>
                            <field name="x_document_acknowledgement" filename="x_document_acknowledgement_filename"/>
                            <field name="x_authorized_work_contract_filename" invisible="1"/>
                            <field name="x_authorized_work_contract" filename="x_authorized_work_contract_filename"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
